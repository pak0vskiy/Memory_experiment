# Copy to .env (deploy/setup-vps.sh does this for you and generates the key).
# ADMIN_KEY: at least 12 characters. While it's missing or a placeholder, the admin page is disabled.
ADMIN_KEY=change-me-to-a-long-random-password

# Real experiment timings (seconds). Leave these as they are for the study.
READ_SEC=240
HIGHLIGHT_SEC=240
TEST_MAX_SEC=180
BLOCK_SEC=240
FEEDBACK_MIN_SEC=60
DAY2_GAP_SEC=172800
DAY9_GAP_SEC=604800

# PILOT MODE: to click through all 3 sessions in a few minutes, temporarily use:
# READ_SEC=10
# HIGHLIGHT_SEC=10
# TEST_MAX_SEC=20
# BLOCK_SEC=30
# FEEDBACK_MIN_SEC=5
# DAY2_GAP_SEC=60
# DAY9_GAP_SEC=60
# then `docker compose up -d` to apply. Afterwards switch back and run deploy/reset-data.sh.

# PIN guessing guard: a nickname is locked for LOGIN_LOCK_SEC after LOGIN_MAX_FAILS wrong PINs.
# LOGIN_MAX_FAILS=8
# LOGIN_LOCK_SEC=900
